    {
      "parameters": {
        "jsCode": "const keywords = [\n  // core stack\n  \"typescript\", \"react\", \"next.js\", \"node.js\", \"express\", \"tailwind\",\n  \"postgresql\", \"supabase\",\n  \"websocket\", \"kafka\", \"golang\",\n  // delivery\n  \"docker\", \"aws\",\n  // front-end state\n  \"firebase\", // AI\n  \"claude\", \"automation\",\n];\n\nreturn $input.all().map(item => {\n  const j = item.json;\n  const text = `${j.title} ${(j.tags || []).join(' ')}`.toLowerCase();\n  const hits = keywords.filter(k => text.includes(k));\n\n  return {\n    json: {\n      title: j.title,\n      company: j.company_name,\n      url: j.url,\n      location: j.candidate_required_location,\n      salary: j.salary || 'not listed',\n      posted: j.publication_date,\n      keywordHits: hits.join(', '),\n      keywordScore: hits.length,\n      // strip HTML so the AI gets clean text\n      summary: (j.description || '')\n        .replace(/<[^>]+>/g, ' ')\n        .replace(/\\s+/g, ' ')\n        .slice(0, 1500),\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "e083a90a-2fdd-4fa5-a940-bfb5fecb2472",
      "name": "Score jobs"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You screen remote jobs for a software engineer based in Addis Ababa, Ethiopia.\nTheir stack: typescript, react, next.js, node.js, express, tailwind, postgresql, supabase, websocket, kafka, golang, docker, firebase, aws, claude, automation.\n\nRate this job from 1 (poor fit) to 10 (excellent fit).\nMark it 1 if it clearly cannot hire from Africa.\n\nTitle: {{ $json.title }}\nCompany: {{ $json.company }}\nLocation rules: {{ $json.location }}\nDescription: {{ $json.summary }}",
        "hasOutputParser": true,
        "batching": {}
      },
