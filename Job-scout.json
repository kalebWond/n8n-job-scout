    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Escape characters that would break Telegram's HTML formatting\nconst esc = s => String(s ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst fit = Math.max(0, Math.min(10, Number($json.fit) || 0));\nconst badge = fit >= 9 ? '🟢' : fit >= 7 ? '🟡' : '⚪';\nconst bar = '■'.repeat(fit) + '□'.repeat(10 - fit);\n\nconst message = [\n  `${badge} <b>${fit}/10 · ${esc($json.title)}</b>`,\n  `<i>${esc($json.company)}</i>`,\n  bar,\n  '',\n  `📍 ${esc($json.location)}   💰 ${esc($json.salary)}`,\n  '',\n  `<blockquote>${esc($json.reason)}</blockquote>`,\n].join('\\n');\n\nreturn { json: { ...$json, message } };"
      },
      "type": "n8n-nodes-base.code",
